# Select configs/default.yaml unless this points to another YAML file.
# GATEKG_CONFIG=/absolute/path/to/config.yaml

# Runtime directories. Relative paths are resolved from GATEKG_HOME.
# GATEKG_HOME=/absolute/path/to/gatekg-project
# GATEKG_DATA_DIR=data
# GATEKG_ARTIFACT_DIR=artifacts
# GATEKG_POLICY_ARTIFACT_DIR=artifacts/gatekg/shared
# GATEKG_LOG_DIR=logs
# GATEKG_CACHE_DIR=.cache

# Provider overrides (optional; YAML remains the source of defaults).
# GATEKG_PROVIDER=ollama
# GATEKG_EMBEDDING_PROVIDER=ollama
# GATEKG_LLM_MODEL=qwen3.5:9b
# GATEKG_KG_PROVIDER=ollama
# GATEKG_KG_MODEL=qwen3.5:9b
# GATEKG_JUDGE_MODEL=gemini-3.8-flash

# Google Gemini API or Vertex AI API key, depending on api.google.provider.
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# VERTEX_API_KEY=

# OpenAI-compatible local endpoints.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_API_KEY=ollama
# VLLM_BASE_URL=http://127.0.0.1:8000
# VLLM_API_KEY=vllm

# Graphiti storage. Required for KG-backed runners.
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=change-me
# NEO4J_DATABASE=neo4j
